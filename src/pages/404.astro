---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Page not found — ${site.name}`} index={false}>
  <main class="notfound">
    <h1>Nothing here.</h1>
    <p>This page doesn’t exist, or it moved. Try the <a href="/">homepage</a> or my <a href={site.github}>GitHub</a>.</p>
  </main>
</Base>
