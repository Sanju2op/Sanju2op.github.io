---
import Base from '../layouts/Base.astro';
import { site, experience, projects, skills, education, achievements } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name, url: `${Astro.site}`, jobTitle: site.role,
  email: site.email, sameAs: [site.github.href, site.linkedin.href, site.portfolio.href],
  knowsAbout: ['JavaScript', 'React', 'Next.js', 'Node.js', 'Express.js', 'MongoDB', 'MySQL', 'Java'],
};
---
<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <a class="skip" href="#main">Skip to content</a>
  <main id="main">
    <header>
      <h1>{site.name}</h1>
      <p class="role">{site.role}</p>
      <ul class="contact">
        <li>{site.location}</li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.portfolio.href}>{site.portfolio.text}</a></li>
        <li><a href={site.github.href}>{site.github.text}</a></li>
        <li><a href={site.linkedin.href}>{site.linkedin.text}</a></li>
      </ul>
      <a class="pdf noprint" href="/resume.pdf" download>Download PDF</a>
    </header>

    <section aria-labelledby="summary"><h2 id="summary">Summary</h2><p class="summary" style="margin-top:0">{site.summary}</p></section>

    <section aria-labelledby="exp">
      <h2 id="exp">Experience</h2>
      <dl class="rows">
        {experience.map((e) => (
          <><dt data-todo={e.todo ? '' : undefined}>{e.when}</dt>
          <dd data-todo={e.todo ? '' : undefined}><strong>{e.title}</strong>{e.note && <span class="note">{e.note}</span>}</dd></>
        ))}
      </dl>
    </section>

    <section aria-labelledby="proj">
      <h2 id="proj">Projects</h2>
      <ul class="projects">
        {projects.map((p) => (
          <li><strong>{p.title}</strong><span class="note">{p.note}</span><a href={p.link.href}>{p.link.text}</a></li>
        ))}
      </ul>
      <p class="more">Case studies and screenshots: <a href={site.portfolio.href}>{site.portfolio.text}</a></p>
    </section>

    <section aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <dl class="rows">{skills.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </section>

    <section aria-labelledby="edu">
      <h2 id="edu">Education</h2>
      <dl class="rows">
        {education.map((e) => <><dt>{e.when}</dt><dd><strong>{e.title}</strong>{e.note && <span class="note">{e.note}</span>}</dd></>)}
      </dl>
    </section>

    <section aria-labelledby="ach">
      <h2 id="ach">Achievements</h2>
      <dl class="rows">
        {achievements.map((e) => <><dt>{e.when}</dt><dd><strong>{e.title}</strong>{e.note && <span class="note">{e.note}</span>}</dd></>)}
      </dl>
    </section>

    <footer class="noprint"><p>Last updated {site.lastUpdated}. The PDF is generated from this page on every deploy.</p></footer>
  </main>
</Base>
